server {
  listen 80;
  server_name bi.kitexp.ru api.bi.kitexp.ru generator.bi.kitexp.ru;

  location ^~ /.well-known/acme-challenge/ {
    root /var/www/certbot;
    default_type text/plain;
    try_files $uri =404;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

server {
  listen 443 ssl;
  server_name bi.kitexp.ru;
  access_log off;
  ssl_certificate ${TLS_CERT_DIR}/fullchain.pem;
  ssl_certificate_key ${TLS_CERT_DIR}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;

  location ^~ /api/analytics/actuator/prometheus { return 404; }
  location ^~ /api/generator/actuator/prometheus { return 404; }

  location /api/analytics/ {
    proxy_pass http://analytics:8080/;
    proxy_set_header Host $host;
    proxy_set_header Authorization $http_authorization;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Trace-Id $http_x_trace_id;
  }
  location /api/generator/ {
    proxy_pass http://generator:8080/;
    proxy_set_header Host $host;
    proxy_set_header Authorization $http_authorization;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Trace-Id $http_x_trace_id;
  }
  location / { proxy_pass http://web:80; }
}

server {
  listen 443 ssl;
  server_name api.bi.kitexp.ru;
  access_log off;
  ssl_certificate ${TLS_CERT_DIR}/fullchain.pem;
  ssl_certificate_key ${TLS_CERT_DIR}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;

  location ^~ /actuator/prometheus { return 404; }
  location / {
    proxy_pass http://analytics:8080;
    proxy_set_header Host $host;
    proxy_set_header Authorization $http_authorization;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Trace-Id $http_x_trace_id;
    proxy_set_header X-Original-URI $request_uri;
  }
}

