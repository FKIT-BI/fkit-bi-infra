      "id": 1,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "targets": [
        {
          "expr": "sum by (outcome) (rate(fkit_bi_ingest_measurements_total[5m]))",
          "legendFormat": "{{application}} {{outcome}}",
          "refId": "A"
        }
      ],
      "title": "Measurement ingest rate",
      "type": "timeseries"
    },
