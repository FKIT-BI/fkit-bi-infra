  "description": "Ingestion and generation domain metrics are planned for follow-up business stories. Empty panels currently mean this instrumentation is not yet implemented; they do not indicate that the service is idle or error-free.",
  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
