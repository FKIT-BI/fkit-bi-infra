POSTGRES_DB=fkit_bi
POSTGRES_USER=fkit_bi
POSTGRES_PASSWORD=replace-with-a-secret
POSTGRES_PORT=5432
ANALYTICS_IMAGE=ghcr.io/fkit-bi/fkit-bi-analytics:dev
GENERATOR_IMAGE=ghcr.io/fkit-bi/fkit-bi-generator:dev
WEB_IMAGE=ghcr.io/fkit-bi/fkit-bi-web:dev
PUBLIC_PORT=8080
GIT_SHA=unknown
COMPOSE_SUBNET=172.29.0.0/24
PROXY_CONTAINER_IP=172.29.0.2
# Replace with a deployment-managed base64 key (at least 32 random bytes).
FKIT_JWT_SECRET=replace-with-base64-encoded-32-byte-random-key
# Default matches the fixed Nginx address on the Compose network; override only with trusted proxy IP/CIDRs.
FKIT_TRUSTED_PROXY_CIDRS=172.29.0.2/32
# Read only by the one-shot `bootstrap-user` command; provide through a secret manager on deployments.
FKIT_BOOTSTRAP_USERNAME=bootstrap
FKIT_BOOTSTRAP_DISPLAY_NAME=Bootstrap operator
FKIT_BOOTSTRAP_PASSWORD=replace-with-a-long-initial-password
